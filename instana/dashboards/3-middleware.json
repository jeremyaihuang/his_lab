   "x": 0,
   "y": 6,
   "width": 6,
   "height": 13,
   "config": {
    "type": "TIME_SERIES",
    "y1": {
     "formatter": "number.detailed",
     "renderer": "line",
     "metrics": [
      {
       "type": "httpd",
       "source": "INFRASTRUCTURE_METRICS",
       "metric": "requests",
       "aggregation": "MEAN",
       "crossSeriesAggregation": "MEAN",
       "label": "IHS requests/s",
       "color": "",
       "tagFilterExpression": {
